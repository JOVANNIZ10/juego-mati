# Copia este archivo como .env.local y rellena los valores.
# La clave se usa solo para generar los audios, nunca se envía al juego.

ELEVENLABS_API_KEY=
# Identificador de la voz elegida en ElevenLabs (Voice Library).
ELEVENLABS_VOICE_ID=
# Opcional: modelo de ElevenLabs. Por defecto eleven_multilingual_v2.
ELEVENLABS_MODEL=
# Opcional: calidad del MP3. Por defecto mp3_44100_64.
ELEVENLABS_OUTPUT_FORMAT=
# Opcional: pausa entre peticiones para no saturar la API (ms). Por defecto 300.
ELEVENLABS_DELAY_MS=
